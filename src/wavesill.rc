#include <windows.h>
#include "version.h"

IDI_APP        ICON "wavesill.ico"
IDI_TRAY_WHITE ICON "tray_white.ico"
IDI_TRAY_BLACK ICON "tray_black.ico"

1 RT_MANIFEST "wavesill.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    WS_VERSION_RC
 PRODUCTVERSION WS_VERSION_RC
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Wavesill"
      VALUE "FileDescription",  "Wavesill - A faint audio spectrum on the taskbar"
      VALUE "FileVersion",      WS_VERSION_A
      VALUE "InternalName",     "Wavesill"
      VALUE "LegalCopyright",   "Copyright (c) 2026 Wavesill contributors. MIT License."
      VALUE "OriginalFilename", "Wavesill.exe"
      VALUE "ProductName",      "Wavesill"
      VALUE "ProductVersion",   WS_VERSION_A
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
